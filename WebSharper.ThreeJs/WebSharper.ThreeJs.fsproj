<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <WebSharperProject>binding</WebSharperProject>
    <WebSharperSourceMap>false</WebSharperSourceMap>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);FS3886</NoWarn>
    <Product>WebSharper.ThreeJs 0.187+</Product>
    <Title>https://github.com/dotnet-websharper/threejs/</Title>
    <Company>IntelliFactory</Company>
    <Copyright>(c) 2008-2026 IntelliFactory</Copyright>
  </PropertyGroup>
  <PropertyGroup>
    <NpmDependencies>
      <NpmPackage Name="three" Version="&gt;= 0.187.0 &lt; 0.188.0" ResolutionStrategy="Max" />
    </NpmDependencies>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Main.fs" />
  </ItemGroup>
  <Import Project="..\.paket\Paket.Restore.targets" />
</Project>